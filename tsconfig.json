{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "main.tsx",
    "components/own-page.tsx",
    "components/solana-trade-panel.tsx",
    "components/ui/sheet.tsx",
    "hooks/use-solana-market.ts",
    "lib/solana-*.ts",
    "lib/official-project.ts",
    "lib/presentation.ts",
    "lib/utils.ts",
    "vite.config.ts",
    "components/marketplace-setup.tsx",
    "worker/index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
